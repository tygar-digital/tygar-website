---
interface Props {
  from?: 'white' | 'surface';
  to?: 'white' | 'surface';
  wave?: boolean;
}
const { from = 'white', to = 'surface', wave = false } = Astro.props;
const colors = {
  white: '#FFFFFF',
  surface: '#F9FAFB',
};
---
<div class="relative overflow-hidden" style={`height:60px;background:linear-gradient(180deg, ${colors[from]} 0%, ${colors[to]} 100%)`}>
  {wave && (
    <svg viewBox="0 0 1200 60" fill="none" class="absolute bottom-0 left-0 w-full opacity-40" preserveAspectRatio="none" aria-hidden="true">
      <path d="M0 30 Q300 5 600 30 T1200 30 V60 H0Z" fill={colors[to] === '#F9FAFB' ? '#F3F4F6' : '#FFFFFF'} />
    </svg>
  )}
</div>
