---
const { data } = Astro.props;
const accent = (text: string) => text.replace(/\*([^*]+)\*/g, '<span class="font-sans font-extrabold">$1</span>');
---
<section id="preise" class="bg-brand-surface">
  <div class="max-w-[1160px] mx-auto px-8 py-[108px]">

    <div class="flex items-center gap-2 text-[0.72rem] font-sans font-bold tracking-[0.12em] uppercase text-brand-muted mb-3">
      <span class="flex-shrink-0 gradient-divider rounded-full"></span>
      {data.label}
    </div>
    <h2 class="font-handwritten font-bold leading-[1.08] tracking-[-0.02em] text-brand-heading mb-4"
      style="font-size:clamp(2rem,4.5vw,3.25rem)"
      set:html={accent(data.heading[0]) + ' ' + accent(data.heading[1])}>
    </h2>
    <p class="text-brand-text leading-[1.75] mb-12 max-w-[580px]">{data.subtext}</p>

    <div class="flex flex-col gap-10">
      {data.sections.map((sec: any, idx: number) => (
        <div class="relative">
          <div class="mb-4">
            <h3 class="font-sans font-semibold text-brand-heading text-lg mb-1">{sec.name}</h3>
            <p class="text-brand-text text-sm">{sec.description}</p>
          </div>
          {idx === 0 ? (
            /* Hauptkarte: dunkles Slate */
            <div class="relative">
              <span class="pricing-intro-badge font-handwritten" data-handwriting="300">Kostenloser Entwurf inklusive!</span>
            <div class="pricing-card pricing-card-dark grid grid-cols-1 md:grid-cols-[1fr_1px_1fr] rounded-[12px] overflow-hidden">

              {/* Einmalig */}
              <div class="p-8 md:p-10 pt-12 md:pt-14">
                <div class="text-[0.68rem] font-sans font-bold tracking-[0.12em] uppercase mb-5" style="color:rgba(255,255,255,0.75)">
                  {sec.onetime.heading}
                </div>
                {sec.onetime.base && (
                  <>
                    <div class="pricing-price-wrap mb-1">
                      {sec.onetime.base.original_price && (
                        <span class="pricing-price-old">{sec.onetime.base.original_price}</span>
                      )}
                      <span class="pricing-price-light">{sec.onetime.base.price}</span>
                      <span class="text-base font-normal ml-2" style="color:rgba(255,255,255,0.75)">einmalig</span>
                    </div>
                    <div class="text-xs mb-6" style="color:rgba(255,255,255,0.75)">{sec.onetime.base.label}</div>
                    {sec.onetime.includes && (
                      <ul class="flex flex-col gap-2.5 list-none">
                        {sec.onetime.includes.map((f: string) => (
                          <li class="flex items-center gap-2.5 text-sm" style="color:rgba(255,255,255,0.85)">
                            <span class="pricing-check-light">✓</span>{f}
                          </li>
                        ))}
                      </ul>
                    )}
                  </>
                )}

                {/* CTA Button */}
                {data.cta && (
                  <a href={data.cta.href}
                    class="inline-flex items-center justify-center mt-8 px-7 py-3.5 rounded-full font-sans font-bold text-sm no-underline"
                    style="background:#0C1425;color:#fff;box-shadow:0 4px 14px rgba(26,43,60,0.35);transition:background 200ms ease,transform 200ms ease">
                    {data.cta.label}
                  </a>
                )}
              </div>

              {/* Divider */}
              <div class="hidden md:block" style="background:rgba(255,255,255,0.15)"></div>
              <div class="md:hidden h-px" style="background:rgba(255,255,255,0.15)"></div>

              {/* Monatlich */}
              <div class="p-8 md:p-10 pt-12 md:pt-14">
                <div class="text-[0.68rem] font-sans font-bold tracking-[0.12em] uppercase mb-5" style="color:rgba(255,255,255,0.75)">
                  {sec.monthly.heading}
                </div>
                {sec.monthly.price && (
                  <>
                    <div class="pricing-price-wrap mb-1">
                      <span class="pricing-price-light">{sec.monthly.price}</span>
                      <span class="text-base font-normal ml-2" style="color:rgba(255,255,255,0.75)">/Monat</span>
                    </div>
                    <div class="text-xs mb-6" style="color:rgba(255,255,255,0.75)">{sec.monthly.note}</div>
                    <ul class="flex flex-col gap-2.5 list-none">
                      {sec.monthly.features?.map((f: string) => (
                        <li class="flex items-center gap-2.5 text-sm" style="color:rgba(255,255,255,0.85)">
                          <span class="pricing-check-light">✓</span>{f}
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            </div>
            </div>
          ) : (
            /* Sekundärkarten: weiß */
            <div class="pricing-card grid grid-cols-1 md:grid-cols-[1fr_1px_1fr] rounded-[12px] border border-[#E5E7EB] overflow-hidden bg-white shadow-[0_1px_3px_rgba(0,0,0,0.05),0_1px_2px_rgba(0,0,0,0.03)]">

              {/* Einmalig */}
              <div class="p-8 md:p-9">
                <div class="text-[0.68rem] font-sans font-bold tracking-[0.12em] uppercase text-brand-muted mb-5">
                  {sec.onetime.heading}
                </div>
                <ul class="flex flex-col gap-3 list-none">
                  {sec.onetime.items?.map((item: any) => (
                    <li class="flex justify-between items-center gap-3 text-sm text-brand-text">
                      <span>{item.label}</span>
                      <span class="font-sans font-bold text-brand-heading whitespace-nowrap">{item.amount}</span>
                    </li>
                  ))}
                </ul>
              </div>

              {/* Divider */}
              <div class="hidden md:block bg-[#E5E7EB]"></div>
              <div class="md:hidden h-px bg-[#E5E7EB]"></div>

              {/* Monatlich */}
              <div class="p-8 md:p-9">
                <div class="text-[0.68rem] font-sans font-bold tracking-[0.12em] uppercase text-brand-muted mb-5">
                  {sec.monthly.heading}
                </div>
                <ul class="flex flex-col gap-3 list-none">
                  {sec.monthly.items?.map((item: any) => (
                    <li class="flex justify-between items-center gap-3 text-sm text-brand-text">
                      <span>{item.label}</span>
                      <span class="font-sans font-bold whitespace-nowrap">{item.amount}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          )}
        </div>
      ))}
    </div>

    <p class="text-center text-brand-muted text-xs mt-6">{data.note}</p>

    <!-- Inline CTA -->
    <div class="text-center pt-10 pb-2 border-t border-brand-border mt-10">
      <span class="font-handwritten text-brand-heading" style="font-size:1.1rem">Überzeugt?</span>
      <a href="mailto:tygar-digital@gmail.com" class="text-brand-primary font-sans font-bold text-sm ml-3 hover:underline">Kostenlosen Entwurf anfordern →</a>
    </div>
  </div>
</section>

<style>
  .pricing-intro-badge {
    position: absolute;
    top: -10px;
    left: 20px;
    padding: 8px 18px;
    background: #E8443A;
    color: #fff;
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.03em;
    border-radius: 6px;
    z-index: 2;
    transform: rotate(-2deg);
    box-shadow: 0 4px 14px rgba(232, 68, 58, 0.35);
  }

  .pricing-card-dark {
    background: #0C1425;
    box-shadow: 0 8px 40px rgba(26, 43, 60, 0.35);
  }

  .pricing-price-old {
    font-family: 'Plus Jakarta Sans Variable', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    line-height: 1;
    color: rgba(255, 255, 255, 0.45);
    letter-spacing: -0.02em;
    text-decoration: line-through;
    margin-right: 12px;
  }

  .pricing-price-light {
    font-family: 'Plus Jakarta Sans Variable', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(2.8rem, 5vw, 3.5rem);
    line-height: 1;
    color: #FFFFFF;
    letter-spacing: -0.02em;
  }

  .pricing-price-wrap {
    display: flex;
    align-items: baseline;
  }

  .pricing-check-light {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .pricing-card {
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .pricing-card:hover {
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .pricing-card-dark:hover {
    box-shadow: 0 12px 48px rgba(26, 43, 60, 0.45);
    transform: translateY(-2px);
  }
</style>
