---
const { items } = Astro.props;
---
{items && items.length > 0 && (
  <div class="bg-brand-bg border-b border-brand-border">
    <div class="max-w-[1160px] mx-auto px-8 py-3 flex justify-center gap-6 md:gap-10 flex-wrap">
      {items.map((item: any) => (
        <div class="flex items-center gap-2 text-brand-muted text-[0.8rem] font-medium">
          <span class="text-brand-primary flex-shrink-0" set:html={item.icon_svg}></span>
          {item.label}
        </div>
      ))}
    </div>
  </div>
)}
