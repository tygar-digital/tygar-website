---
import { Image } from 'astro:assets';
import handwerkerImg from '../assets/handwerker.webp';
import janImg from '../assets/jan.webp';

const { data } = Astro.props;
const accent = (text: string) => text.replace(/\*([^*]+)\*/g, '<span class="font-extrabold">$1</span>');
const accentColors: Record<string, { main: string; light: string }> = {
  emerald: { main: '#0F766E', light: '#CCFBF1' },
  cyan:    { main: '#0D9488', light: '#CCFBF1' },
  violet:  { main: '#134E4A', light: '#CCFBF1' },
};
---
<section id="ueber-mich" class="bg-brand-surface">
  <div class="max-w-[1160px] mx-auto px-8 py-20 md:py-28">

    <!-- Mission / Values -->
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-12 items-center mb-12">
      <div>
        <div class="flex items-center gap-2 text-[0.72rem] font-sans font-bold tracking-[0.12em] uppercase text-brand-muted mb-3">
          <span class="flex-shrink-0 gradient-divider rounded-full"></span>
          {data.mission_label}
        </div>
        <h2 class="font-handwritten font-normal leading-[1.08] tracking-[-0.02em] text-brand-heading mb-4"
          style="font-size:clamp(2rem,4.5vw,3.25rem)"
          set:html={accent(data.mission_headline[0]) + '<br/>' + accent(data.mission_headline[1])}>
        </h2>
        <p class="text-brand-heading leading-[1.75]">{data.mission_statement}</p>
      </div>

      {data.mission_image && (
        <div class="hidden lg:block rounded-xl overflow-hidden border border-brand-border relative shadow-sm"
          style="aspect-ratio:4/3">
          <Image src={handwerkerImg} alt={data.mission_image.alt} class="w-full h-full object-cover" loading="lazy" decoding="async" />
          <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent pointer-events-none"></div>
        </div>
      )}
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {data.values.map((val: any) => (
        <div class="rounded-xl border border-brand-border p-7 flex flex-col gap-4 bg-white shadow-sm hover:shadow-md transition-shadow gradient-border-hover">
          <div class="w-11 h-11 rounded-xl flex items-center justify-center flex-shrink-0"
            style={`background:${accentColors[val.accent]?.light || '#CCFBF1'};color:${accentColors[val.accent]?.main || '#0F766E'}`}
            set:html={val.icon_svg}>
          </div>
          <h3 class="font-sans font-semibold text-brand-heading">{val.title}</h3>
          <p class="text-brand-text text-sm leading-relaxed">{val.text}</p>
        </div>
      ))}
    </div>

    <!-- Personal Bio -->
    <div class="flex items-center gap-2 text-[0.72rem] font-sans font-bold tracking-[0.12em] uppercase text-brand-muted mb-3">
      <span class="flex-shrink-0 gradient-divider rounded-full"></span>
      {data.label}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_360px] gap-16 items-start">
      <div>
        <h2 class="font-handwritten font-normal leading-[1.08] tracking-[-0.02em] text-brand-heading mb-2"
          style="font-size:clamp(2rem,4.5vw,3.25rem)"
          set:html={accent(data.headline[0]) + '<br/>' + accent(data.headline[1])}>
        </h2>
        <span class="inline-block font-handwritten text-sm -rotate-2 mb-6" style="color:#0F766E" data-handwriting="400">persönlich. immer.</span>
        <p class="text-brand-heading leading-[1.75] mb-5">{data.bio}</p>
        <p class="text-brand-heading leading-[1.75] mb-8">{data.bio2}</p>
        <div class="flex flex-wrap gap-2">
          {data.tags.map((tag: string) => (
            <span class="text-xs font-sans px-3 py-1.5 rounded-full"
              style="background:#CCFBF1;color:#0F766E">
              {tag}
            </span>
          ))}
        </div>
      </div>

      {data.image ? (
        <div class="rounded-xl overflow-hidden aspect-[3/4] border border-brand-border relative shadow-sm">
          <Image
            src={janImg}
            alt={data.image.alt}
            class="w-full h-full object-cover object-[center_15%]"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/15 via-transparent to-transparent pointer-events-none"></div>
        </div>
      ) : (
        <div class="rounded-xl overflow-hidden aspect-[3/4] flex items-center justify-center border border-brand-border bg-white shadow-sm">
          <div class="text-center p-8">
            <div class="w-16 h-16 rounded-full mx-auto mb-4 flex items-center justify-center"
              style="background:#CCFBF1;border:1px solid rgba(15,118,110,0.25)">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#0F766E" stroke-width="1.5" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            <p class="text-brand-muted text-sm font-sans">Foto folgt</p>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
