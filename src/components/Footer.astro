---
import fs from 'node:fs';
import path from 'node:path';
const { brand, footer } = Astro.props;
const logoPath = path.join(process.cwd(), 'public', brand.logo_svg);
const logoSvg = fs.readFileSync(logoPath, 'utf-8');
---
<footer class="bg-[#111827]">

  {/* Mini-CTA Bar */}
  {footer.cta && (
    <div class="border-b border-white/10">
      <div class="max-w-[1160px] mx-auto px-8 py-10 flex flex-col sm:flex-row items-center justify-between gap-6">
        <h3 class="font-heading italic text-white text-center sm:text-left" style="font-size:clamp(1.25rem,2.5vw,1.6rem)">
          {footer.cta.heading}
        </h3>
        <a href={footer.cta.href}
          class="inline-flex items-center justify-center px-7 py-3.5 rounded-full font-body font-bold text-sm no-underline flex-shrink-0"
          style="background:#059669;color:#fff;box-shadow:0 4px 14px rgba(5,150,105,0.35);transition:background 200ms ease,transform 200ms ease">
          {footer.cta.label}
        </a>
      </div>
    </div>
  )}

  {/* Bottom Bar */}
  <div class="max-w-[1160px] mx-auto px-8 py-8">
    <div class="flex flex-col md:flex-row justify-between items-center gap-6">

      {/* Logo + Contact Info */}
      <div class="flex flex-col sm:flex-row items-center gap-5">
        <a href="#" class="flex items-center gap-2.5 no-underline">
          <span class="footer-logo-svg" set:html={logoSvg} aria-label={brand.name + ' Logo'}></span>
          <span class="font-heading font-medium text-lg tracking-tight text-white">{brand.name}</span>
        </a>
        <div class="flex items-center gap-4 text-xs font-body text-white/50">
          {brand.location && (
            <span class="flex items-center gap-1.5">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              {brand.location}
            </span>
          )}
          {brand.email && (
            <a href={`mailto:${brand.email}`} class="flex items-center gap-1.5 text-white/50 hover:text-white transition-colors no-underline">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              {brand.email}
            </a>
          )}
        </div>
      </div>

      {/* Legal + Social */}
      <div class="flex items-center gap-5 flex-wrap justify-center">
        {footer.legal_links.map((l: any) => (
          <a href={l.href} class="text-xs font-body text-white/50 transition-colors hover:text-white no-underline">
            {l.label}
          </a>
        ))}
        {brand.social?.linkedin && brand.social.linkedin !== '#' && (
          <a href={brand.social.linkedin} target="_blank" rel="noopener noreferrer"
            class="text-xs font-body text-white/50 transition-colors hover:text-white no-underline">
            LinkedIn
          </a>
        )}
        {brand.social?.instagram && brand.social.instagram !== '#' && (
          <a href={brand.social.instagram} target="_blank" rel="noopener noreferrer"
            class="text-xs font-body text-white/50 transition-colors hover:text-white no-underline">
            Instagram
          </a>
        )}
      </div>
    </div>

    {/* Copyright */}
    <div class="mt-6 pt-6 border-t border-white/10 text-center">
      <span class="text-xs font-body text-white/40">{footer.copyright}</span>
    </div>
  </div>
</footer>

<style>
  .footer-logo-svg {
    display: inline-flex;
    color: #FFFFFF;
    height: 32px;
    width: auto;
  }
  .footer-logo-svg :global(svg) {
    height: 32px;
    width: auto;
  }
</style>
