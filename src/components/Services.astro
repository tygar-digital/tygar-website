---
const { data } = Astro.props;
const accent = (text: string) => text.replace(/\*([^*]+)\*/g, '<span class="font-sans font-extrabold">$1</span>');
const accentColors: Record<string, { main: string; light: string; gradient: string }> = {
  emerald: { main: '#7EFFDA', light: '#E6FFF8', gradient: 'linear-gradient(180deg, #5AD4B5, #7EFFDA)' },
  cyan:    { main: '#0891B2', light: '#ECFEFF', gradient: 'linear-gradient(180deg, #0891B2, #22D3EE)' },
  violet:  { main: '#7C3AED', light: '#F5F3FF', gradient: 'linear-gradient(180deg, #7C3AED, #A78BFA)' },
};
const stepColors = ['#7EFFDA', '#0891B2', '#0891B2', '#7C3AED'];
---
<section id="leistungen" class="bg-brand-bg">
  <div class="max-w-[1160px] mx-auto px-8 py-[108px]">

    <div class="flex items-center gap-2 text-[0.72rem] font-sans font-bold tracking-[0.12em] uppercase text-brand-muted mb-3">
      <span class="flex-shrink-0 gradient-divider rounded-full"></span>
      {data.label}
    </div>
    <h2 class="font-handwritten font-bold leading-[1.08] tracking-[-0.02em] text-brand-heading mb-4"
      style="font-size:clamp(2rem,4.5vw,3.25rem)"
      set:html={accent(data.heading[0]) + ' ' + accent(data.heading[1])}>
    </h2>
    {data.subtext && <p class="text-brand-text leading-[1.75] mb-12 max-w-[580px]">{data.subtext}</p>}

    <!-- Horizontal Service Cards -->
    <div class="flex flex-col gap-4">
      {data.items.map((item: any) => {
        const colors = accentColors[item.accent] || accentColors.emerald;
        return (
          <div class={`service-card rounded-[12px] border border-[#E5E7EB] flex overflow-hidden bg-white shadow-[0_1px_3px_rgba(0,0,0,0.05),0_1px_2px_rgba(0,0,0,0.03)] ${item.coming_soon ? 'opacity-35 pointer-events-none grayscale-[30%]' : ''}`}>
            {/* Accent side stripe */}
            <div class="hidden sm:block w-[3px] flex-shrink-0 rounded-l-[12px]"
              style={`background:${item.coming_soon ? '#D1D5DB' : colors.gradient}`}></div>

            {/* Mobile: top stripe */}
            <div class="sm:hidden absolute top-0 left-0 right-0 h-[3px]"
              style={`background:${item.coming_soon ? '#D1D5DB' : colors.gradient}`}></div>

            <div class="flex flex-col sm:flex-row gap-5 p-7 sm:p-8 flex-1 relative">
              {item.coming_soon && (
                <span class="absolute top-4 right-4 text-[0.65rem] font-sans font-bold tracking-[0.08em] uppercase px-2.5 py-1 rounded-full border border-[#E5E7EB] text-brand-muted bg-[#F9FAFB]">
                  Coming Soon
                </span>
              )}

              <div class="w-14 h-14 rounded-[14px] flex items-center justify-center flex-shrink-0"
                style={`background:${item.coming_soon ? 'rgba(138,138,170,0.10)' : colors.light};
                        color:${item.coming_soon ? '#6B7280' : colors.main}`}
                set:html={item.icon_svg}>
              </div>

              <div class="flex-1">
                <h3 class={`font-sans font-semibold text-lg mb-1.5 ${item.coming_soon ? 'text-brand-muted' : 'text-brand-heading'}`}>{item.title}</h3>
                <p class={`text-sm leading-relaxed mb-4 ${item.coming_soon ? 'text-brand-muted' : 'text-brand-text'}`}>{item.text}</p>
                {item.features && (
                  <div class="flex flex-wrap gap-2">
                    {item.features.map((f: string) => (
                      <span class="text-[0.75rem] font-sans px-3 py-1 rounded-full"
                        style={`background:${item.coming_soon ? '#F3F4F6' : colors.light};color:${item.coming_soon ? '#6B7280' : colors.main}`}>
                        ✓ {f}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Inline CTA -->
    <div class="text-center pt-10 pb-2 border-t border-brand-border mt-10">
      <span class="font-handwritten text-brand-heading" style="font-size:1.1rem">Klingt gut?</span>
      <a href="mailto:tygar-digital@gmail.com" class="text-brand-primary font-sans font-bold text-sm ml-3 hover:underline">Kostenlosen Entwurf anfordern →</a>
    </div>

    <!-- Process Timeline -->
    <div class="pt-20">
      <div class="flex items-center gap-2 text-[0.72rem] font-sans font-bold tracking-[0.12em] uppercase text-brand-muted mb-3">
        <span class="flex-shrink-0 gradient-divider rounded-full"></span>
        {data.process_label}
      </div>
      <h3 class="font-handwritten font-bold leading-[1.08] tracking-[-0.02em] text-brand-heading mb-4"
        style="font-size:clamp(2rem,4.5vw,3.25rem)"
        set:html={accent(data.process_heading[0]) + ' ' + accent(data.process_heading[1])}>
      </h3>
      <p class="text-brand-text leading-[1.75] mb-12 max-w-[580px]">{data.process_subtext}</p>

      <!-- Desktop: horizontal timeline -->
      <div class="hidden lg:block">
        <div class="timeline-container relative flex">
          {data.steps.map((step: any, i: number) => (
            <div class="flex-1 text-center relative z-10">
              <div class="timeline-dot mx-auto mb-4"
                style={`background:${stepColors[i] || '#7EFFDA'};box-shadow:0 2px 8px ${stepColors[i] || '#7EFFDA'}40`}>
                {step.number}
              </div>
              <div class="text-[0.6rem] font-sans font-bold tracking-[0.1em] uppercase text-brand-muted mb-1">{step.phase}</div>
              <div class="font-sans font-semibold text-brand-heading mb-1">{step.title}</div>
              <p class="text-brand-text text-sm leading-relaxed mx-auto max-w-[200px] mb-3">{step.text}</p>
              <span class="inline-block text-[0.72rem] font-handwritten px-3 py-1 rounded-full"
                style={`background:${accentColors[Object.keys(accentColors)[Math.min(i, 2)]]?.light || '#E6FFF8'};color:${stepColors[i] || '#7EFFDA'}`}>
                {step.duration}
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Mobile: vertical timeline -->
      <div class="lg:hidden flex flex-col gap-0 relative pl-14">
        <div class="absolute left-[27px] top-[14px] bottom-[14px] w-[2px]"
          style="background:linear-gradient(180deg, #7EFFDA, #0891B2, #7C3AED)"></div>
        {data.steps.map((step: any, i: number) => (
          <div class="relative pb-8 last:pb-0">
            <div class="absolute left-[-42px] top-0 timeline-dot-sm"
              style={`background:${stepColors[i] || '#7EFFDA'};box-shadow:0 2px 6px ${stepColors[i] || '#7EFFDA'}40`}>
              {step.number}
            </div>
            <div class="text-[0.6rem] font-sans font-bold tracking-[0.1em] uppercase text-brand-muted mb-1">{step.phase}</div>
            <div class="font-sans font-semibold text-brand-heading mb-1">{step.title}</div>
            <p class="text-brand-text text-sm leading-relaxed mb-2">{step.text}</p>
            <span class="inline-block text-[0.72rem] font-handwritten px-3 py-1 rounded-full"
              style={`background:${accentColors[Object.keys(accentColors)[Math.min(i, 2)]]?.light || '#E6FFF8'};color:${stepColors[i] || '#7EFFDA'}`}>
              {step.duration}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .service-card {
    position: relative;
    transition: transform 280ms cubic-bezier(.4,0,.2,1), box-shadow 280ms cubic-bezier(.4,0,.2,1);
  }
  .service-card:not([class*="opacity"]):hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
  }

  .timeline-container::before {
    content: '';
    position: absolute;
    top: 14px;
    left: 12.5%;
    right: 12.5%;
    height: 2px;
    background: linear-gradient(90deg, #7EFFDA, #5AD4B5, #0891B2, #7C3AED);
    border-radius: 2px;
  }

  .timeline-dot {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    font-family: 'Plus Jakarta Sans Variable', system-ui, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid #fff;
  }

  .timeline-dot-sm {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    font-family: 'Plus Jakarta Sans Variable', system-ui, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 3px solid #fff;
  }
</style>
