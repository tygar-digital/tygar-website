---
const { data } = Astro.props;
const accent = (text: string) => text.replace(/\*([^*]+)\*/g, '$1');
---
<section id="beispiele" class="bg-brand-bg">
  <div class="max-w-[1160px] mx-auto px-8 py-[108px]">

    <div class="flex items-center gap-2 text-[0.72rem] font-sans font-bold tracking-[0.12em] uppercase text-brand-muted mb-3">
      <span class="flex-shrink-0 gradient-divider rounded-full"></span>
      {data.label}
    </div>
    <h2 class="font-handwritten font-bold leading-[1.08] tracking-[-0.02em] text-brand-heading mb-4"
      style="font-size:clamp(2rem,4.5vw,3.25rem)"
      set:html={accent(data.heading[0]) + '<br/>' + accent(data.heading[1])}>
    </h2>
    <p class="text-brand-heading leading-[1.75] mb-12 max-w-[580px]">{data.subtext}</p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {data.items.map((item: any) => (
        <a href={item.preview_url} target="_blank" rel="noopener noreferrer"
          class="showcase-card rounded-xl border border-brand-border flex flex-col overflow-hidden bg-white shadow-[0_1px_3px_rgba(0,0,0,0.05),0_1px_2px_rgba(0,0,0,0.03)] no-underline">

          <div class="relative overflow-hidden" style="height:200px;background:#F9FAFB">
            <div class="flex items-center gap-1.5 px-3 py-2 border-b border-brand-border" style="background:#F9FAFB">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/60"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/60"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-500/60"></span>
              <div class="ml-2 flex-1 h-5 rounded bg-white flex items-center px-2 border border-brand-border">
                <span class="text-[0.6rem] text-brand-muted truncate">{item.preview_url}</span>
              </div>
            </div>
            <div class="absolute inset-0 top-[33px] flex items-center justify-center" style="background:#F9FAFB">
              <div class="text-center">
                <div class="w-12 h-12 rounded-full mx-auto mb-3 flex items-center justify-center"
                  style="background:#CCFBF1;border:1px solid rgba(15,118,110,0.25)">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                    style="stroke:#0F766E">
                    <rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>
                  </svg>
                </div>
                <p class="text-xs text-brand-muted">Vorschau demnächst verfügbar</p>
              </div>
            </div>
            <iframe src={new URL(item.preview_url).pathname + '/index.html'} loading="lazy" tabindex="-1" title={item.title}
              class="w-full border-0 pointer-events-none relative z-10"
              style="height:400px;transform:scale(0.5);transform-origin:top left;width:200%">
            </iframe>
          </div>

          <div class="p-6 flex flex-col gap-3 flex-1">
            <span class="inline-block text-[0.72rem] font-sans px-3 py-1 rounded-full self-start"
              style="background:#CCFBF1;color:#0F766E">
              {item.tag}
            </span>
            <h3 class="font-sans font-semibold text-brand-heading text-lg">{item.title}</h3>
            <p class="text-brand-text text-sm leading-relaxed flex-1">{item.text}</p>
            <span class="text-sm font-sans mt-1" style="color:#0F766E">
              {item.cta}
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Inline CTA -->
    <div class="text-center pt-10 pb-2 border-t border-brand-border mt-10">
      <span class="font-handwritten text-brand-heading" style="font-size:1.1rem">Gefällt dir, was du siehst?</span>
      <a href="mailto:tygar-digital@gmail.com" class="font-sans font-bold text-sm ml-3 hover:underline" style="color:#0F766E">Erstgespräch buchen →</a>
    </div>
  </div>
</section>

<style>
  .showcase-card {
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: transform 280ms cubic-bezier(.4,0,.2,1), box-shadow 280ms cubic-bezier(.4,0,.2,1);
  }

  .showcase-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }
</style>
