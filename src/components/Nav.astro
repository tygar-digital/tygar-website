---
import fs from 'node:fs';
import path from 'node:path';
const { brand, nav } = Astro.props;
const logoPath = path.join(process.cwd(), 'public', brand.logo_svg);
const logoSvg = fs.readFileSync(logoPath, 'utf-8');
---

<nav id="main-nav" class="fixed top-0 left-0 right-0 z-[200] h-[72px] transition-all duration-300"
  style="background: transparent; backdrop-filter: blur(16px); border-bottom: 1px solid transparent;">
  <div class="max-w-[1160px] mx-auto px-8 h-full flex justify-between items-center">

    <a href="#" class="flex items-center gap-2.5 no-underline">
      <span class="nav-logo-svg" set:html={logoSvg} aria-label={brand.name + ' Logo'}></span>
      <span class="font-sans font-bold text-xl tracking-tight nav-brand-text" style="color:#FFFFFF">{brand.name}</span>
    </a>

    <ul class="hidden lg:flex gap-8 items-center list-none">
      {nav.links.map((link: any) => (
        <li>
          <a href={link.href}
            class="text-[15px] font-sans font-medium transition-colors nav-link"
            style="color:rgba(255,255,255,0.7)"
            >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a href={nav.cta.href}
          class="font-sans font-bold text-sm px-5 py-2.5 transition-all hover:-translate-y-0.5 hover:opacity-90"
          style="background:#0C1425;color:#FFFFFF;border-radius:50px">
          {nav.cta.label}
        </a>
      </li>
    </ul>

    <button id="hamburger" aria-label="Menü öffnen"
      class="lg:hidden flex flex-col justify-center items-center w-11 h-11 gap-[5px] p-2 rounded-md transition-colors hover:bg-black/5">
      <span class="block w-[22px] h-[2px] rounded transition-all origin-center hamburger-line" style="background:#FFFFFF"></span>
      <span class="block w-[22px] h-[2px] rounded transition-all origin-center hamburger-line" style="background:#FFFFFF"></span>
      <span class="block w-[22px] h-[2px] rounded transition-all origin-center hamburger-line" style="background:#FFFFFF"></span>
    </button>
  </div>
</nav>

<!-- Mobile overlay -->
<div id="mobile-overlay"
  class="fixed inset-0 z-[199] flex-col px-8 overflow-y-auto"
  style="background:#FFFFFF; padding-top: calc(72px + 32px); padding-bottom: 48px; display:none;">
  <ul class="list-none flex flex-col gap-1 flex-1">
    {nav.links.map((link: any) => (
      <li>
        <a href={link.href}
          class="flex items-center py-4 font-sans font-bold text-2xl transition-colors nav-link"
          style="color:#6B7280;border-bottom:1px solid #E5E7EB">
          {link.label}
        </a>
      </li>
    ))}
  </ul>
  <div class="mt-8">
    <a href={nav.cta.href}
      class="block w-full text-center font-sans font-bold text-base px-6 py-4"
      style="background:#0C1425;color:#FFFFFF;border-radius:50px">
      {nav.cta.label}
    </a>
  </div>
</div>

<script>
  const hamburger   = document.getElementById('hamburger')!;
  const overlay     = document.getElementById('mobile-overlay')!;
  const navLinks    = document.querySelectorAll('.nav-link');

  function openMenu() {
    overlay.style.display = 'flex';
    overlay.classList.add('is-open');
    hamburger.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    updateNav();
  }

  function closeMenu() {
    overlay.style.display = 'none';
    overlay.classList.remove('is-open');
    hamburger.classList.remove('is-open');
    document.body.style.overflow = '';
    updateNav();
  }

  hamburger.addEventListener('click', () => {
    overlay.classList.contains('is-open') ? closeMenu() : openMenu();
  });

  navLinks.forEach(l => l.addEventListener('click', closeMenu));

  // Nav scroll: transparent on dark hero → white bg when scrolled
  const nav = document.getElementById('main-nav')!;
  const brandText = nav.querySelector('.nav-brand-text') as HTMLElement;
  const logoSvg = nav.querySelector('.nav-logo-svg') as HTMLElement;
  const hamburgerLines = nav.querySelectorAll('.hamburger-line');
  const heroSection = document.getElementById('hero');
  const heroHeight = heroSection ? heroSection.offsetHeight * 0.4 : 300;
  const sections = document.querySelectorAll('section[id]');
  let current = '';

  function updateNav() {
    const menuOpen = hamburger.classList.contains('is-open');
    const scrolled = window.scrollY > heroHeight || menuOpen;
    if (scrolled) {
      nav.style.background = 'rgba(255,255,255,0.90)';
      nav.style.borderBottomColor = '#E5E7EB';
      if (brandText) brandText.style.color = '#0C1425';
      if (logoSvg) logoSvg.style.color = '#0C1425';
      hamburgerLines.forEach(l => (l as HTMLElement).style.background = '#0C1425');
      navLinks.forEach(l => {
        const isActive = l.getAttribute('href') === '#' + current;
        (l as HTMLElement).style.color = isActive ? '#0C1425' : '#6B7280';
      });
    } else {
      nav.style.background = 'transparent';
      nav.style.borderBottomColor = 'transparent';
      if (brandText) brandText.style.color = '#FFFFFF';
      if (logoSvg) logoSvg.style.color = '#FFFFFF';
      hamburgerLines.forEach(l => (l as HTMLElement).style.background = '#FFFFFF');
      navLinks.forEach(l => {
        const isActive = l.getAttribute('href') === '#' + current;
        (l as HTMLElement).style.color = isActive ? '#FFFFFF' : 'rgba(255,255,255,0.7)';
      });
    }
  }

  // Scroll spy
  function updateActive() {
    current = '';
    sections.forEach(s => {
      if (window.scrollY >= (s as HTMLElement).offsetTop - 130) current = s.id;
    });
    updateNav();
  }
  window.addEventListener('scroll', updateActive, { passive: true });
  updateActive();
</script>

<style>
  .nav-logo-svg {
    display: inline-flex;
    color: #0C1425;
    height: 32px;
    width: auto;
  }
  .nav-logo-svg :global(svg) {
    height: 32px;
    width: auto;
  }

  /* Hamburger → X animation */
  #hamburger.is-open .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  #hamburger.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #hamburger.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }
</style>
