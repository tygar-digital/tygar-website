---
const { data } = Astro.props;
const accent = (text: string) => text.replace(/\*([^*]+)\*/g, '<span class="font-extrabold">$1</span>');
---
<section id="faq" class="bg-brand-bg">
  <div class="max-w-[1160px] mx-auto px-8 py-20 md:py-28">

    <div class="flex items-center gap-2 text-[0.72rem] font-sans font-bold tracking-[0.12em] uppercase text-brand-muted mb-3">
      <span class="flex-shrink-0 gradient-divider rounded-full"></span>
      {data.label}
    </div>
    <h2 class="font-handwritten font-normal leading-[1.08] tracking-[-0.02em] text-brand-heading mb-4"
      style="font-size:clamp(2rem,4.5vw,3.25rem)"
      set:html={accent(data.heading[0]) + ' ' + accent(data.heading[1])}>
    </h2>

    <div class="max-w-[760px] mt-10 flex flex-col gap-2">
      {data.items.map((item: any, i: number) => (
        <div class="rounded-xl overflow-hidden bg-white border border-brand-border" id={`faq-${i}`}>
          <button
            class="w-full flex justify-between items-center gap-4 px-6 py-4 text-left font-sans font-semibold text-[0.95rem] text-brand-heading cursor-pointer bg-transparent border-none"
            aria-expanded="false"
            aria-controls={`faq-answer-${i}`}
            data-faq-toggle={i}>
            {item.q}
            <svg class="flex-shrink-0 w-5 h-5 text-brand-muted transition-all duration-300" aria-hidden="true"
              viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </button>
          <div class="overflow-hidden transition-all duration-300 max-h-0" id={`faq-answer-${i}`} role="region" aria-labelledby={`faq-btn-${i}`}>
            <p class="px-6 pb-4 text-brand-text leading-[1.7] text-sm">{item.a}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element).closest('[data-faq-toggle]');
    if (!btn) return;

    const i = btn.getAttribute('data-faq-toggle');
    const answer = document.getElementById(`faq-answer-${i}`);
    const icon = btn.querySelector('svg');
    if (!answer) return;

    const isOpen = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
    answer.style.maxHeight = isOpen ? '0px' : answer.scrollHeight + 'px';
    if (icon) {
      icon.style.transform = isOpen ? '' : 'rotate(180deg)';
      icon.style.color = isOpen ? '' : '#7EFFDA';
    }
  });
</script>
