---
import Base     from '../layouts/Base.astro';
import Nav      from '../components/Nav.astro';
import Hero     from '../components/Hero.astro';
import TrustBar from '../components/TrustBar.astro';
import Showcase from '../components/Showcase.astro';
import Services from '../components/Services.astro';
import Pricing  from '../components/Pricing.astro';
import About    from '../components/About.astro';
import FAQ      from '../components/FAQ.astro';
import Footer         from '../components/Footer.astro';
import SectionDivider from '../components/SectionDivider.astro';

import data from '../data/content.json';
---

<Base
  title={data.meta.title}
  description={data.meta.description}
  canonical={data.meta.canonical}
  ogImage={data.meta.og_image}
>
  <Nav brand={data.brand} nav={data.nav} />
  <main>
    <Hero      data={data.hero} />
    <TrustBar  items={data.hero.trust_badges} />
    <Showcase  data={data.showcase} />
    <SectionDivider from="white" to="white" wave />
    <Services  data={data.services} />
    <SectionDivider from="white" to="surface" wave />
    <Pricing   data={data.pricing} />
    <SectionDivider from="surface" to="surface" />
    <About     data={data.about} />
    <SectionDivider from="surface" to="white" wave />
    <FAQ       data={data.faq} />
    <SectionDivider from="white" to="surface" />
  </main>
  <Footer brand={data.brand} footer={data.footer} />
</Base>

<script>
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReduced) {
    // ── Scroll Fade-in with Stagger ──
    const fadeTargets = document.querySelectorAll('[data-animate]');
    fadeTargets.forEach(el => {
      const htmlEl = el as HTMLElement;
      htmlEl.style.opacity = '0';
      htmlEl.style.transform = 'translateY(24px)';
      htmlEl.style.transition = `opacity 0.6s cubic-bezier(0.22,1,0.36,1) ${htmlEl.dataset.delay || '0'}ms, transform 0.6s cubic-bezier(0.22,1,0.36,1) ${htmlEl.dataset.delay || '0'}ms`;
    });

    const fadeObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          el.style.opacity = '1';
          el.style.transform = 'none';
          fadeObserver.unobserve(el);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    fadeTargets.forEach(el => fadeObserver.observe(el));

    // ── Handwriting Reveal ──
    const handwritingTargets = document.querySelectorAll('[data-handwriting]');
    handwritingTargets.forEach(el => {
      const htmlEl = el as HTMLElement;
      htmlEl.style.opacity = '0';
      htmlEl.style.clipPath = 'inset(0 100% 0 0)';
      htmlEl.style.transition = 'opacity 0.5s ease, clip-path 0.8s cubic-bezier(0.22,1,0.36,1)';
      htmlEl.style.transitionDelay = (htmlEl.dataset.handwriting || '400') + 'ms';
    });

    const handwritingObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          el.style.opacity = '1';
          el.style.clipPath = 'inset(0 0 0 0)';
          handwritingObserver.unobserve(el);
        }
      });
    }, { threshold: 0.1 });
    handwritingTargets.forEach(el => handwritingObserver.observe(el));

    // ── SVG Line Draw ──
    const drawTargets = document.querySelectorAll('[data-draw]');
    drawTargets.forEach(el => {
      const path = el as SVGPathElement;
      const length = path.getTotalLength?.() || 200;
      path.style.strokeDasharray = `${length}`;
      path.style.strokeDashoffset = `${length}`;
      path.style.transition = 'stroke-dashoffset 1s ease';
    });

    const drawObserver = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          (entry.target as SVGPathElement).style.strokeDashoffset = '0';
          drawObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1 });
    drawTargets.forEach(el => drawObserver.observe(el));

    // ── Auto-stagger grid children ──
    document.querySelectorAll('section [class*="grid"]').forEach(grid => {
      Array.from(grid.children).forEach((child, i) => {
        if (!child.hasAttribute('data-animate')) {
          const htmlChild = child as HTMLElement;
          htmlChild.setAttribute('data-animate', 'fade-up');
          htmlChild.setAttribute('data-delay', `${i * 80}`);
          htmlChild.style.opacity = '0';
          htmlChild.style.transform = 'translateY(24px)';
          htmlChild.style.transition = `opacity 0.6s cubic-bezier(0.22,1,0.36,1) ${i * 80}ms, transform 0.6s cubic-bezier(0.22,1,0.36,1) ${i * 80}ms`;
          fadeObserver.observe(htmlChild);
        }
      });
    });
  }

  // ── Smooth Scroll ──
  document.addEventListener('click', e => {
    const a = (e.target as Element).closest('a[href^="#"]');
    if (!a) return;
    const target = document.querySelector(a.getAttribute('href')!);
    if (target) { e.preventDefault(); target.scrollIntoView({ behavior: 'smooth' }); }
  });
</script>
