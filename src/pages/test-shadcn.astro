---
import Base from '../layouts/Base.astro';
import { Button } from '../components/ui/button';
---

<Base
  title="shadcn/ui Test"
  description="Testing shadcn/ui integration"
  canonical="https://tygar-digital.de/test-shadcn"
>
  <main class="min-h-screen flex flex-col items-center justify-center gap-6 p-8">
    <h1 class="text-h2 font-sans font-bold text-brand-heading">shadcn/ui Test</h1>
    <p class="text-brand-muted">Wenn du gestylte Buttons siehst, funktioniert das Setup.</p>

    <div class="flex gap-4 flex-wrap justify-center">
      <Button client:load>Default</Button>
      <Button client:load variant="secondary">Secondary</Button>
      <Button client:load variant="outline">Outline</Button>
      <Button client:load variant="destructive">Destructive</Button>
      <Button client:load variant="ghost">Ghost</Button>
      <Button client:load variant="link">Link</Button>
    </div>

    <p class="text-sm text-brand-muted mt-8">
      Bestehende Brand-Klassen funktionieren weiterhin:
      <span class="text-brand-heading font-sans font-bold">brand-heading</span>,
      <span class="bg-brand-surface px-2 py-1 rounded">brand-surface</span>
    </p>
  </main>
</Base>
